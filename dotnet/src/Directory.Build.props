<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Shared NuGet metadata of the packages under src/. Versioning policy: docs/VERSIONING.md. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>SamuraiKenshin</Authors>
    <PackageProjectUrl>https://github.com/Corinth-dev/Corinth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Corinth-dev/Corinth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>corinth;ccf;corinthian-columnar-format;columnar;binary;serialization;aspnetcore;content-negotiation;api;json-alternative;typescript</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Source Link ships with the .NET 8+ SDK: no package needed. ContinuousIntegrationBuild is set by CI. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md')" />
  </ItemGroup>
</Project>
