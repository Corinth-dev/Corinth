<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Default `dotnet test` selection: everything except the golden-vector conformance tests, which fail with
         NotImplementedException until phase 1. Run them with: dotnet test with the filter Category=Conformance.
         Phase 1 deletes this property once the vectors pass. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=Conformance</VSTestTestCaseFilter>
  </PropertyGroup>
</Project>
