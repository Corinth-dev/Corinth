<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Ccf.AspNetCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>ASP.NET Core integration for CCF (Columnar Compact Format): output formatter, content negotiation, schema endpoint and metrics. JSON stays the default; clients opt in with Accept: application/vnd.ccf.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Ccf.Core\Ccf.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ccf.AspNetCore.Tests" />
  </ItemGroup>
</Project>
