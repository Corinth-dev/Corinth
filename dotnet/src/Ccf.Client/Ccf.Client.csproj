<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SKM.Ccf.Client</PackageId>
    <RootNamespace>Ccf.Client</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>HttpClient helper for CCF (Columnar Compact Format): asks for CCF, verifies and caches schemas, decodes into your types and falls back to JSON.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ccf.Core\Ccf.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ccf.Client.Tests" />
  </ItemGroup>
</Project>
