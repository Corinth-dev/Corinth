{
  "name": "@ccf/typegen",
  "version": "0.1.0",
  "description": "Generates TypeScript interfaces from CCF schemas",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "ccf-typegen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ccf/client": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:conformance": "echo 'ccf-typegen: no conformance tests'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuraiKenshin/CCF.git",
    "directory": "js/packages/typegen"
  },
  "homepage": "https://github.com/SamuraiKenshin/CCF#readme",
  "keywords": [
    "ccf",
    "columnar",
    "binary",
    "api",
    "json-alternative",
    "typescript",
    "codegen"
  ],
  "publishConfig": {
    "access": "public"
  }
}
