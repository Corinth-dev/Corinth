{
  "name": "@corinth/client",
  "version": "0.1.0",
  "description": "Corinth: CCF (Corinthian Columnar Format) client for browsers and Node 20+",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "test:conformance": "vitest run conformance",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corinth-dev/Corinth.git",
    "directory": "js/packages/client"
  },
  "homepage": "https://github.com/Corinth-dev/Corinth#readme",
  "keywords": [
    "ccf",
    "corinth",
    "corinthian-columnar-format",
    "columnar",
    "binary",
    "api",
    "json-alternative"
  ],
  "publishConfig": {
    "access": "public"
  }
}
