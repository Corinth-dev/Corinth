<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SKM.Ccf.Scalar</PackageId>
    <RootNamespace>Ccf.Scalar</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Development tooling for CCF (Columnar Compact Format) in ASP.NET Core: describes CCF in the OpenAPI document and lets the Scalar API reference show CCF responses as decoded JSON, with an on/off toggle.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Ccf.AspNetCore\Ccf.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Scalar 2.x: tested with 2.18.2 (the floor, what CI restores) and 2.21.0. The script relies on Scalar's customFetch and JavaScript-configuration options; a Scalar 3.0 needs a new release of this package. -->
    <PackageReference Include="Scalar.AspNetCore" Version="[2.18.2,3.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive\SKM.Ccf.Scalar.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="scalar-viewer.js" LogicalName="Ccf.Scalar.scalar-viewer.js" />
  </ItemGroup>
</Project>
