<Project>
  <!--
    Microsoft.AspNetCore.OpenApi reaches your project through Corinth.Scalar. Its XML-comment source generator then
    runs, but the package's own build file (which enables the generator's interceptors) is not applied to transitive
    references. Enable them here so a project that does not reference Microsoft.AspNetCore.OpenApi itself still builds.
  -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>
</Project>
