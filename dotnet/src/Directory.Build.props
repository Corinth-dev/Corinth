<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Shared NuGet metadata of the packages under src/. Versioning policy: docs/VERSIONING.md. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>SamuraiKenshin</Authors>
    <PackageProjectUrl>https://github.com/SamuraiKenshin/CCF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SamuraiKenshin/CCF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ccf;columnar;binary;serialization;aspnetcore;api;json-alternative</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md')" />
  </ItemGroup>
</Project>
