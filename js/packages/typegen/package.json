{
  "name": "@corinth/typegen",
  "version": "0.1.0",
  "description": "Corinth: generates TypeScript interfaces from CCF (Corinthian Columnar Format) schemas",
  "type": "module",
  "license": "MIT",
  "bin": {
    "corinth-typegen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@corinth/client": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:conformance": "echo 'corinth-typegen: no conformance tests'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuraiKenshin/Corinth.git",
    "directory": "js/packages/typegen"
  },
  "homepage": "https://github.com/SamuraiKenshin/Corinth#readme",
  "keywords": [
    "ccf",
    "corinth",
    "corinthian-columnar-format",
    "columnar",
    "binary",
    "api",
    "json-alternative",
    "typescript",
    "codegen"
  ],
  "publishConfig": {
    "access": "public"
  }
}
